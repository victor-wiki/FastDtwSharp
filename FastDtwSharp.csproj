<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>victor-wiki.$(AssemblyName)</PackageId>
    <Version>1.0.0</Version>
    <Authors>victor-wiki</Authors>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Description>C# implementation of fastdtw, which is an approximate Dynamic Time Warping (DTW) algorithm that provides optimal or near-optimal alignments with an O(N) time and memory complexity.</Description>
    <RepositoryUrl>https://github.com/victor-wiki/FastDtwSharp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.70.0" />
  </ItemGroup>

</Project>
